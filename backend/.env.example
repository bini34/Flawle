# .env.example
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Yegna Storage
YEGNA_ACCESS_KEY=your-access-key
YEGNA_SECRET_KEY=your-secret-key
YEGNA_BUCKET=your-bucket-name
YEGNA_ENDPOINT=https://s3.yegnadev.com

# Chapa
CHAPA_SECRET_KEY=CHASECK_TEST-XXXXXXXXXXXXXXXX

# Celery
CELERY_BROKER=redis://redis:6379/0